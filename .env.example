# ==============================================================================
# Configurações do Monitor de Incidentes P&G (og-monitor)
# Copie este arquivo para .env na raiz do projeto e preencha suas credenciais.
# ==============================================================================

# --- Banco de Dados (PostgreSQL) ---
OG_DB_HOST=localhost
OG_DB_PORT=5432
OG_DB_NAME=og_monitor
OG_DB_USER=og_user
OG_DB_PASSWORD=og_password

# --- Coleta e Janela Retroativa ---
# Quantidade de dias retroativos considerados na busca RSS e no pré-filtro dbt
DIAS_RETROATIVOS=7
# Limiar mínimo de linhas no SISO para considerar a base completa nos alertas
SISO_MIN_LINHAS=50

# --- Classificação com IA (API Groq) ---
# Informe uma ou mais chaves separadas por vírgula para rodízio automático (KeyPool)
GROQ_API_KEYS=gsk_sua_chave_1,gsk_sua_chave_2
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.1
GROQ_REASONING_EFFORT=low
GROQ_MAX_COMPLETION_TOKENS=2000
# Pausa (segundos) entre chamadas à Groq para respeitar o limite de tokens/minuto do plano gratuito
GROQ_SLEEP_SECONDS=45
MAX_NOTICIAS_POR_EXECUCAO=40
TEXTO_MAX_CHARS=3500
LIMIAR_SIMILARIDADE_TITULO=0.85

# --- Agendamento Prefect (servir.py) ---
AGENDA_CRON=0 7,13,18 * * *
AGENDA_TIMEZONE=America/Sao_Paulo

# --- Alertas por E-mail (SMTP) ---
# Destinatários separados por vírgula (deixe vazio para desativar o envio de e-mails)
ALERTA_DESTINATARIOS=
ALERTA_SEVERIDADES=CRÍTICO,ALTO,MÉDIO,INFORMATIVO
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=False
SMTP_USER=
SMTP_PASSWORD=
SMTP_MAIL_FROM=monitor-incidentes@exemplo.com
